{
  "extends": ["react-app", "react-app/jest"],
  "overrides": [
    {
      "files": ["src/**/*.{js,jsx,ts,tsx}"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "error",
        "quotes": ["error", "double"],
        "semi": ["error", "always"],
        "no-console": "error",
        "eqeqeq": ["error", "always"]
      }
    }
  ]
}
